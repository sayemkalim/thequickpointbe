PORT=
MONGO_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=
APP_URL=http://localhost:5000
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration
# Using Brevo API (recommended for production)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM_EMAIL=your-verified-email@domain.com
EMAIL_FROM_NAME=QuickPoint Dairy

# Legacy SMTP Configuration (fallback - may not work on all hosting providers)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# Note: Company emails are sent to all super_admin and admin users from the Admin database

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Shiprocket Configuration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=

# ==========================================
# Multi-Outlet Dairy Platform (Bihar)
# ==========================================
# Default location proximity search radius in Kilometers
DEFAULT_RADIUS_KM=15

# Transactional SMS Configuration (for Customer Mobile OTP & Pickup Verification)
# Supported: "brevo", "mock" (auto-logs to console in dev/test)
SMS_PROVIDER=mock
SMS_SENDER_ID=DAIRY

# Optional Cashfree Payment Gateway (separate provider alongside Razorpay)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# CASHFREE_ENV: TEST (sandbox) or PROD (production)
CASHFREE_ENV=TEST
